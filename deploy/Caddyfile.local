# Caddy config for local testing: self-signed certificate (tls internal), so the
# browser warns about the certificate. Open https://localhost:8443.
# The container name is registered too, so it can be tested from another container.
https://localhost:8443, https://anabul-caddy:8443 {
	tls internal
	encode zstd gzip
	reverse_proxy app:8080
}
