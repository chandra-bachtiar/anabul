# Konfigurasi Caddy untuk uji lokal: sertifikat self-signed (tls internal),
# jadi browser akan memperingatkan sertifikat. Buka https://localhost:8443.
# Nama container ikut didaftarkan supaya bisa diuji juga dari container lain.
https://localhost:8443, https://anabul-caddy:8443 {
	tls internal
	encode zstd gzip
	reverse_proxy app:8080
}
