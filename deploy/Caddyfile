# Caddy config for public deployment: automatic HTTPS via Let's Encrypt.
# DOMAIN comes from the environment (see docker-compose.prod.yml).
{$DOMAIN} {
	encode zstd gzip

	# HSTS is safe here because Caddy terminates TLS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy app:8080
}
