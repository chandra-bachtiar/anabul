# Server
PORT=8080
TZ=Asia/Jakarta

# Database.
# Neon (the usual setup): copy the connection string from the Neon dashboard, it
# looks like the line below. A "-pooler" host works too, the server switches to
# query mode by itself.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/anabul?sslmode=require
#
# Local Postgres from docker compose (for tinkering and tests only):
DATABASE_URL=postgres://app:app@localhost:5432/finance?sslmode=disable

# Auth.
# Build a password hash with: cd apps/api && go run ./cmd/password "new-password"
# The hash is copied into app_settings the first time the server starts, so once
# you change the password from the Settings page, leave this value alone.
# Default password for local use: anabul123 (change it after the first login).
# Without any password the /api endpoints stay unusable (the server still runs
# and /healthz answers).
APP_PASSWORD_HASH=
SESSION_SECRET=
# Old secret, filled in only while rotating SESSION_SECRET so existing sessions
# survive. Clear it again once those sessions have expired.
SESSION_SECRET_PREVIOUS=

# Reverse proxy.
# true when the app runs behind a proxy such as Caddy/Nginx: X-Forwarded-For and
# X-Forwarded-Proto then feed rate limiting and Secure cookies.
TRUST_PROXY=false

# Error notifications (optional). Set a webhook URL (a Telegram bot, for example)
# to receive a short message on 5xx errors or a failed start.
ALERT_WEBHOOK_URL=

# Public domain for the Telegram webhook, e.g. https://anabul.example.com
# Used by `make webhook`. For docker-compose.prod.yml, set DOMAIN as well.
PUBLIC_URL=
DOMAIN=

# Agent LLM (OpenAI-compatible endpoint). Empty means the agent falls back to the
# simple parser, so "kopi 25rb" still gets recorded.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Telegram (optional). The bot only serves TELEGRAM_OWNER_CHAT_ID.
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
