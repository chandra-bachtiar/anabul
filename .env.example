# Server
PORT=8080
TZ=Asia/Jakarta

# Database.
# Neon (yang dipakai sehari-hari): ambil connection string dari dashboard Neon,
# bentuknya seperti di bawah. Endpoint "-pooler" juga jalan, server otomatis
# menyesuaikan mode query.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/anabul?sslmode=require
#
# Postgres lokal dari docker compose (buat ngoprek/tes saja):
DATABASE_URL=postgres://app:app@localhost:5432/finance?sslmode=disable

# Auth.
# Bikin hash password dengan: cd apps/api && go run ./cmd/password "password-baru"
# Hash ini disalin ke tabel app_settings saat server pertama kali menyala, jadi
# setelah kamu ganti password lewat halaman Pengaturan, biarkan nilai ini apa adanya.
# Password default untuk pemakaian lokal: anabul123 (ganti setelah berhasil masuk).
# Tanpa password sama sekali, endpoint /api tidak bisa dipakai (server tetap jalan,
# /healthz hidup).
APP_PASSWORD_HASH=
SESSION_SECRET=
# Secret lama, diisi sementara saat rotasi SESSION_SECRET supaya sesi yang sudah
# ada tidak langsung mati. Kosongkan lagi setelah semua sesi lama kedaluwarsa.
SESSION_SECRET_PREVIOUS=

# Reverse proxy.
# true kalau aplikasi berjalan di belakang proxy seperti Caddy/Nginx: header
# X-Forwarded-For dan X-Forwarded-Proto dipakai untuk rate limit dan cookie Secure.
TRUST_PROXY=false

# Notifikasi error (opsional). Isi URL webhook (mis. bot Telegram) untuk menerima
# pesan singkat saat terjadi error 5xx atau server gagal start.
ALERT_WEBHOOK_URL=

# Domain publik untuk webhook Telegram, mis. https://anabul.contoh.com
# Dipakai oleh `make webhook`. Untuk docker-compose.prod.yml, isi DOMAIN juga.
PUBLIC_URL=
DOMAIN=

# Agent LLM (endpoint OpenAI-compatible). Vakum = agent memakai parser sederhana,
# jadi "kopi 25rb" tetap tercatat.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Telegram (opsional). Bot hanya melayani TELEGRAM_OWNER_CHAT_ID.
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
